{
  "name": "hotel-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sitio web estático de hotel alimentado por la API del PMS",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:fetch": "node --env-file-if-exists=.env --import tsx scripts/fetch-snapshot.ts",
    "verify": "npm run check && npm run lint && npm run test && npm run build",
    "api:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-api-contract.ts",
    "images:check": "node --import tsx scripts/check-images.ts",
    "brand:assets": "node --import tsx scripts/make-brand-assets.ts",
    "predev": "node --import tsx scripts/ensure-snapshot.ts",
    "prebuild": "node --import tsx scripts/ensure-snapshot.ts",
    "data:fixture": "node --import tsx scripts/fixture-snapshot.ts",
    "data:assert-live": "node --import tsx scripts/assert-live-data.ts",
    "lhci": "npm run build && lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/karla": "5.3.0",
    "astro": "7.4.5",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
