---
/**
 * Respaldo de las rutas del sitio Angular anterior (`/roomTypes`, `/contactUS`…): ver `MovedPage`. La redirección
 * buena es el 301 del `.htaccess` (playbook 07, generado con `htaccessRedirects()`).
 */
import MovedPage from '../components/MovedPage.astro';
import { LEGACY_REDIRECTS } from '../lib/legacy.ts';
import { routes, routeUrl, type RouteKey } from '../lib/routes.ts';
import { siteConfig } from '../lib/site.ts';

export function getStaticPaths() {
  return LEGACY_REDIRECTS.map(({ from, to }) => ({
    params: { legacy: from.replace(/^\//, '') },
    props: { to },
  }));
}

const { to } = Astro.props as { to: RouteKey };
// Comprobación en build: la ruta destino existe en el mapa.
if (!routes[to]) throw new Error(`Redirección a una ruta inexistente: ${to}`);
---

<MovedPage target={routeUrl(to, siteConfig.defaultLocale)} lang="es" />
