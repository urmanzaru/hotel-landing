---
import type { Locale } from '../../clients/types.ts';
import Button from '../components/Button.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { getSnapshot } from '../data/load.ts';
import { t } from '../i18n/ui.ts';
import Page from '../layouts/Page.astro';
import { addressLine, mapLinks, pick } from '../lib/content.ts';
import { routeUrl } from '../lib/routes.ts';
import { siteConfig } from '../lib/site.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { hotel } = getSnapshot();
const address = addressLine(hotel.address);
const links = mapLinks(siteConfig.coordinates);
---

<Page
  locale={locale}
  current="location"
  label={t(locale, 'location.title')}
  description={t(locale, 'location.lead')}
>
  <PageHeader
    locale={locale}
    title={t(locale, 'location.title')}
    lead={t(locale, 'location.lead')}
  />
  <Section tight>
    <div class="grid">
      <div class="block">
        <h2>{t(locale, 'location.address')}</h2>
        <p class="address">
          <strong>{pick(hotel.name, locale)}</strong>
          <br />
          {address || t(locale, 'contact.empty')}
        </p>
        <p class="maps">
          <Button href={links.google} variant="secondary" target="_blank" rel="noopener noreferrer">
            {t(locale, 'location.map.google')}
          </Button>
          <Button href={links.osm} variant="ghost" target="_blank" rel="noopener noreferrer">
            {t(locale, 'location.map.osm')}
          </Button>
        </p>
      </div>
      <div class="block">
        <h2>{t(locale, 'time.title')}</h2>
        <dl class="times">
          <div>
            <dt>{t(locale, 'time.checkin')}</dt>
            <dd>{hotel.checkInTime}</dd>
          </div>
          <div>
            <dt>{t(locale, 'time.checkout')}</dt>
            <dd>{hotel.checkOutTime}</dd>
          </div>
        </dl>
        <p>
          <Button href={routeUrl('contact', locale)} variant="ghost">
            {t(locale, 'nav.contact')}
          </Button>
        </p>
      </div>
    </div>
  </Section>
</Page>

<style>
  .grid {
    display: grid;
    gap: var(--space-7);
  }
  .block {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .block h2 {
    font-size: var(--text-xl);
  }
  .address {
    font-size: var(--text-lg);
  }
  .maps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .times {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .times div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: 18rem;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }
  .times dt {
    color: var(--color-text-muted);
  }
  .times dd {
    margin: 0;
    font-weight: 700;
  }
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: 1.3fr 1fr;
    }
  }
</style>
