---
import type { Locale } from '../../clients/types.ts';
import Button from '../components/Button.astro';
import Gallery from '../components/Gallery.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { getSnapshot } from '../data/load.ts';
import { t } from '../i18n/ui.ts';
import Page from '../layouts/Page.astro';
import { langFor, paragraphs, pick, roomMeta, toPlainText, truncate } from '../lib/content.ts';
import { ogImagePath } from '../lib/og.ts';
import { absoluteUrl, hotelRoomJsonLd, serializeJsonLd } from '../lib/seo.ts';
import { siteConfig } from '../lib/site.ts';
import { url } from '../lib/url.ts';
import { roomCover, roomGallery } from '../lib/photos.ts';
import { roomUrl, routeUrl } from '../lib/routes.ts';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const snapshot = getSnapshot();
const room = snapshot.roomTypes.find((candidate) => candidate.slug === slug);
if (!room) throw new Error(`No existe la habitación "${slug}" en el snapshot`);

const name = pick(room.name, locale);
const description = pick(room.description, locale);
const photos = roomGallery(snapshot, room, locale);
const cover = roomCover(snapshot, room);
const abs = (path: string) => absoluteUrl(siteConfig.origin, path);
const roomJsonLd = hotelRoomJsonLd({
  room,
  locale,
  url: abs(roomUrl(locale, room.slug)),
  hotelId: `${abs(routeUrl('home', siteConfig.defaultLocale))}#hotel`,
  image: cover ? abs(url(ogImagePath(`room-${room.slug}`))) : undefined,
});
const quoteHref = `${routeUrl('quote', locale)}?room=${encodeURIComponent(room.slug)}`;
---

<Page
  locale={locale}
  current="rooms"
  label={name}
  description={truncate(
    [toPlainText(description) || t(locale, 'rooms.lead'), roomMeta(locale, room)].join(' · '),
    155,
  )}
  paths={{ es: roomUrl('es', room.slug), en: roomUrl('en', room.slug) }}
  ogImage={cover ? `room-${room.slug}` : undefined}
>
  <PageHeader
    locale={locale}
    title={name}
    titleLang={langFor(room.name, locale)}
    lead={roomMeta(locale, room)}
    trail={[{ label: t(locale, 'rooms.title'), href: routeUrl('rooms', locale) }]}
  />
  <Section tight>
    <div class="detail">
      <div class="detail__text">
        {paragraphs(description).map((paragraph) => (
          <p class="detail__p" lang={langFor(room.description, locale)}>
            {paragraph}
          </p>
        ))}
        <div class="detail__actions">
          <Button href={quoteHref} size="lg">
            {t(locale, 'rooms.quote')}
          </Button>
          <Button href={routeUrl('rooms', locale)} variant="ghost">
            {t(locale, 'rooms.back')}
          </Button>
        </div>
      </div>
    </div>
  </Section>

  {photos.length > 0 && (
    <Section tone="cream" title={t(locale, 'rooms.photos', { name })}>
      <Gallery locale={locale} label={t(locale, 'rooms.photos', { name })} items={photos} />
    </Section>
  )}
  <script is:inline type="application/ld+json" set:html={serializeJsonLd(roomJsonLd)} />
</Page>

<style>
  .detail__text {
    display: grid;
    gap: var(--space-4);
    max-width: 46rem;
  }
  .detail__p {
    white-space: pre-line;
    font-size: var(--text-lg);
  }
  .detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
