---
/**
 * Casilla de verificación accesible: casilla de 24 px (WCAG 2.2, tamaño de objetivo) y etiqueta clicable de al menos
 * 44 px de alto. Ayuda y error asociados con `aria-describedby`; con `liveError` el contenedor del error existe
 * siempre (oculto) para que un script lo rellene. El contenido extra (p. ej. un enlace) va en el slot, FUERA de la
 * etiqueta, para no anidar elementos interactivos.
 */
interface Props {
  id: string;
  name?: string;
  label: string;
  required?: boolean;
  requiredLabel?: string;
  checked?: boolean;
  value?: string;
  error?: string | undefined;
  liveError?: boolean;
  hidden?: boolean;
}

const {
  id,
  name = id,
  label,
  required = false,
  requiredLabel = 'obligatorio',
  checked = false,
  value = 'on',
  error,
  liveError = false,
  hidden = false,
} = Astro.props;

const hasSlot = Astro.slots.has('default');
const helpId = hasSlot ? `${id}-help` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [helpId, errorId].filter(Boolean).join(' ') || undefined;
---

<div class:list={['check', { 'check--error': Boolean(error) }]} hidden={hidden}>
  <div class="check__row">
    <input
      class="check__input"
      type="checkbox"
      id={id}
      name={name}
      value={value}
      checked={checked}
      required={required || undefined}
      aria-describedby={describedBy}
      aria-invalid={error ? 'true' : undefined}
    />
    <label for={id} class="check__label">
      <span>
        {label}
        {required && <span class="check__req">({requiredLabel})</span>}
      </span>
    </label>
  </div>
  {hasSlot && (
    <div id={helpId} class="check__help">
      <slot />
    </div>
  )}
  {(error || liveError) && (
    <p id={`${id}-error`} class="check__error" hidden={!error}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path
          d="M12 7v6m0 4h.01"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
        />
        <circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="2" />
      </svg>
      <span data-error-text>{error}</span>
    </p>
  )}
</div>

<style>
  .check {
    display: grid;
    gap: var(--space-2);
  }
  .check[hidden] {
    display: none;
  }
  .check__row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .check__input {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin: calc((var(--tap-size) - 1.5rem) / 2) 0 0;
    accent-color: var(--color-brand);
    cursor: pointer;
  }
  .check__input:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .check__label {
    display: flex;
    align-items: center;
    min-height: var(--tap-size);
    font-weight: 700;
    cursor: pointer;
  }
  .check__req {
    margin-inline-start: var(--space-1);
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .check__help {
    padding-inline-start: calc(1.5rem + var(--space-3));
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .check--error .check__input {
    outline: 2px solid var(--color-danger);
    outline-offset: 2px;
  }
  .check__error {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline-start: calc(1.5rem + var(--space-3));
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-danger);
  }
  .check__error[hidden] {
    display: none;
  }
  .check__error svg {
    flex: none;
  }
</style>
