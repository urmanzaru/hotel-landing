# Copia este archivo a `.env` para desarrollo local. `.env` NO se versiona.
# Todas las variables son opcionales: sin ellas se usan los valores de clients/<CLIENT>.config.ts.

# Cliente (hotel) a construir. Debe existir en clients/ y estar registrado en site.config.ts.
CLIENT=lacabana

# Origin con el que la API del PMS identifica al hotel (campo `url` del hotel en el PMS).
# En desarrollo el sitio debe servirse exactamente aquí: `npm run dev` usa el puerto de esta URL.
SITE_ORIGIN=http://localhost:4202

# URL base de la API del PMS (entorno de pruebas durante el desarrollo).
PUBLIC_API_URL=https://apihotel-dev.spinoff.website

# Id del hotel en el PMS.
HOTEL_ID=5fe1ffca46f0600fec51463d

# Las credenciales FTP NO van aquí: solo como secretos de GitHub Actions (ver playbook 07).
